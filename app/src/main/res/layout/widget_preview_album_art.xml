<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nb_widget_tile">
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_music_placeholder"
        android:tint="@color/nb_widget_text_muted" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="8dp"
        android:background="@drawable/widget_lock_surface_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="0dp"
            android:background="@drawable/widget_lock_button_background"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/rounded_skip_previous_24"
            android:tint="@color/nb_widget_on_accent" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_button_primary_background"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/rounded_play_arrow_24"
            android:tint="@color/nb_widget_on_accent" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_lock_button_background"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/rounded_skip_next_24"
            android:tint="@color/nb_widget_on_accent" />
    </LinearLayout>
</FrameLayout>

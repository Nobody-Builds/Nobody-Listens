<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_album_art_placeholder"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_music_placeholder"
            android:tint="@color/nb_widget_text_muted" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Now playing"
            android:textColor="@color/nb_widget_text"
            android:textSize="13sp" android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nobody Listens"
            android:textColor="@color/nb_widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_primary_background"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/rounded_play_arrow_24"
            android:tint="@color/nb_widget_on_accent" />
</LinearLayout>

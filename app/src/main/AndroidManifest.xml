<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Party queue server (connectedDevice FGS; CHANGE_WIFI_STATE above is its granted prerequisite). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Focus sessions: user-started timer that runs in the foreground (FocusService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- MANAGE_EXTERNAL_STORAGE removed for Google Play compliance.
         Write access to individual files is obtained via MediaStore.createWriteRequest(). -->
    <!-- Required only on Android 11 and below for legacy Bluetooth discovery and Wi-Fi SSID access. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />
    <!-- Screensaver weather: approximate location, asked only when the user turns on "Use my approximate location" -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- For disabling battery optimization -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Taste match: scan a friend's QR code (asked only when the user taps "Scan a friend") -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".NobodyListensApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NobodyListens"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NobodyListens"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.nobodybuilds.listens.action.OPEN_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".presentation.telegram.auth.TelegramLoginActivity"
            android:exported="false"
            android:label="Telegram Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.netease.auth.NeteaseLoginActivity"
            android:exported="false"
            android:label="Netease Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.gdrive.auth.GDriveLoginActivity"
            android:exported="false"
            android:label="Google Drive Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.qqmusic.auth.QqMusicLoginActivity"
            android:exported="false"
            android:label="QQ Music Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.navidrome.auth.NavidromeLoginActivity"
            android:exported="false"
            android:label="Navidrome Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.jellyfin.auth.JellyfinLoginActivity"
            android:exported="false"
            android:label="Jellyfin Login"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.ytmusic.auth.YouTubeMusicLoginActivity"
            android:exported="false"
            android:label="YouTube Music"
            android:theme="@style/Theme.NobodyListens" />

        <activity
            android:name=".presentation.ytmusic.video.YouTubeMusicVideoActivity"
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="YouTube video"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:supportsPictureInPicture="true"
            android:taskAffinity="${applicationId}.video"
            android:theme="@style/Theme.NobodyListens" />


        <!-- Screensaver (standby) mode: Settings › Appearance › Screensaver, or the charging prompt -->
        <activity
            android:name=".presentation.screensaver.ScreensaverActivity"
            android:exported="false"
            android:label="Screensaver"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.NobodyListens.Screensaver"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize" />

        <activity
            android:name=".ExternalPlayerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NobodyListens.ExternalPlayer"
            android:excludeFromRecents="true"
            android:grantUriPermissions="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="audio/*" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.service.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <receiver
            android:name=".ui.glancewidget.NobodyListensGlanceWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nobody_listens_glance_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.BarWidget4x1Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bar_widget_4x1_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.ControlWidget4x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/control_widget_4x2_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.GridWidget2x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/grid_widget_2x2_info" />
        </receiver>

        <receiver
            android:name=".ui.glancewidget.GardenWidget2x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/garden_widget_2x2_info" />
        </receiver>

        <!-- v1.4 widgets (Daylight): now playing, album art, queue, lofi & focus, stats, recently played, lock screen. -->
        <receiver
            android:name=".ui.glancewidget.NowPlayingWidget2x1Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget_2x1_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.AlbumArtWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/album_art_widget_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.QueueWidget4x3Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/queue_widget_4x3_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.LofiFocusWidget2x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lofi_focus_widget_2x2_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.StatsWidget2x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_2x2_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.RecentWidget4x2Receiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/recent_widget_4x2_info" />
        </receiver>
        <receiver
            android:name=".ui.glancewidget.LockScreenWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lock_screen_widget_info" />
        </receiver>

        <receiver android:name=".data.service.SleepTimerReceiver" android:exported="false" />

        <!-- Media Button Receiver for external media controls (headphones, car, etc.) -->
        <receiver
            android:name=".data.service.NobodyListensMediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- *** AÑADE ESTE BLOQUE PARA DESHABILITAR EL INICIALIZADOR POR DEFECTO *** -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Esto evita que el inicializador de WorkManager se ejecute automáticamente -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver android:name=".ui.glancewidget.WidgetUpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.nobodybuilds.listens.ACTION_WIDGET_UPDATE_PLAYBACK_STATE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.service.http.MediaFileHttpServerService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service
            android:name=".data.lofi.LofiService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service
            android:name=".data.focus.FocusService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="focus_timer: a user-started focus (Pomodoro) timer with a live countdown notification, pause/skip/stop controls and chimes at each phase change; sessions run for up to several hours, often without audio" />
        </service>
        <!-- Focus phase-end alarms (works from the background; never starts a foreground service). -->
        <receiver android:name=".data.focus.FocusAlarmReceiver" android:exported="false" />
        <service
            android:name=".data.party.PartyServerService"
            android:foregroundServiceType="connectedDevice"
            android:exported="false" />
        <service
            android:name=".data.service.wear.WatchTransferForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.nobodybuilds.listens.data.service.cast.CastOptionsProvider" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name=".data.provider.SharedArtworkContentProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="true" />

        <!-- Wear OS Data Layer: receives playback/volume commands from the watch -->
        <service
            android:name=".data.service.wear.WearCommandReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/playback_command" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/volume_command" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/browse_request" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/transfer_request" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/transfer_cancel" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/transfer_progress" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/watch_library_state" />
            </intent-filter>
        </service>

        <!-- Quick Settings Tiles -->
        <service
            android:name=".data.service.tile.ShuffleAllTileService"
            android:exported="true"
            android:label="@string/tile_shuffle_all"
            android:icon="@drawable/ic_shortcut_shuffle"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".data.service.tile.LastPlaylistTileService"
            android:exported="true"
            android:label="@string/tile_last_playlist"
            android:icon="@drawable/ic_shortcut_playlist"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".data.service.tile.FocusTileService"
            android:exported="true"
            android:label="@string/tile_focus"
            android:icon="@drawable/ic_tile_focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".data.service.tile.LofiTileService"
            android:exported="true"
            android:label="@string/tile_lofi"
            android:icon="@drawable/ic_tile_lofi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".data.service.tile.NoiseTileService"
            android:exported="true"
            android:label="@string/tile_noise"
            android:icon="@drawable/ic_tile_noise"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- System screen saver (Settings › Display › Screen saver) using the same screensaver UI -->
        <service
            android:name=".presentation.screensaver.NobodyListensDreamService"
            android:exported="true"
            android:label="Nobody Listens"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>

</manifest>
